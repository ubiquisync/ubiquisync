---
source: crates/ubiquisync-sql/src/replica/init.rs
expression: "create_table_sql(crate::dialect::SqlDialect::Sqlite).join(\";\\n\")"
---
CREATE TABLE IF NOT EXISTS "__replica_peers" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "peer_id" BLOB NOT NULL, "commitment_bytes" BLOB NOT NULL, "signature" BLOB NOT NULL, UNIQUE("peer_id"));;
CREATE TABLE IF NOT EXISTS "__replica_containers" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "container_id" BLOB NOT NULL, "topic_id" INTEGER NULL, UNIQUE("container_id"));;
CREATE TABLE IF NOT EXISTS "__replica_streams" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "peer_id" INTEGER NOT NULL, "container_id" BLOB NOT NULL, "head_size" INTEGER NOT NULL, "head_hash" BLOB NOT NULL, "head_cipher" BLOB NULL, "head_err" BLOB NULL, "commit_size" INTEGER NOT NULL, "commit_err" BLOB NULL, "parent_id" INTEGER NULL, "fork_size" INTEGER NULL);;
CREATE TABLE IF NOT EXISTS "__replica_segments" ("stream_id" INTEGER NOT NULL, "end_size" INTEGER NOT NULL, "start_idx" INTEGER NOT NULL, "body" BLOB NOT NULL, PRIMARY KEY("stream_id", "end_size")) WITHOUT ROWID;;
CREATE TABLE IF NOT EXISTS "__replica_hlc" ("id" INTEGER NOT NULL, "timestamp" INTEGER NOT NULL, PRIMARY KEY("id")) WITHOUT ROWID;;
CREATE TABLE IF NOT EXISTS "__pack_remotes" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "provider" TEXT NOT NULL, "config" TEXT NOT NULL);;
CREATE TABLE IF NOT EXISTS "__pack_topics" ("id" INTEGER PRIMARY KEY AUTOINCREMENT, "topic" TEXT NOT NULL, UNIQUE("topic"));;
CREATE TABLE IF NOT EXISTS "__pack_topic_state" ("remote_id" INTEGER NOT NULL, "topic_id" INTEGER NOT NULL, "dirty" INTEGER NOT NULL, "write_state" BLOB NOT NULL, PRIMARY KEY("remote_id", "topic_id")) WITHOUT ROWID;;
CREATE TABLE IF NOT EXISTS "__pack_published" ("remote_id" INTEGER NOT NULL, "stream_id" INTEGER NOT NULL, "published_size" INTEGER NOT NULL, "pending_since" INTEGER NULL, PRIMARY KEY("remote_id", "stream_id")) WITHOUT ROWID;;
CREATE TABLE IF NOT EXISTS "__pack_read_state" ("remote_id" INTEGER NOT NULL, "topic_id" INTEGER NOT NULL, "peer_id" INTEGER NOT NULL, "state" BLOB NOT NULL, PRIMARY KEY("remote_id", "topic_id", "peer_id")) WITHOUT ROWID;
