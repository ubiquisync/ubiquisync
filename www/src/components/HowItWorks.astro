---
/**
 * Three-step "How it works" flow. Each vignette is drawn in the logo's
 * visual language: the same node circles, wire weights, and comet shape.
 */
const icons = import.meta.glob<string>(
	'/node_modules/@phosphor-icons/core/assets/duotone/*.svg',
	{ query: '?raw', import: 'default' }
);
const cloudRaw = await icons['/node_modules/@phosphor-icons/core/assets/duotone/cloud-duotone.svg']();
// embed as a nested <svg> positioned inside the vignette's coordinate space
const cloud = cloudRaw.replace('<svg ', '<svg x="112" y="46" width="56" height="56" ');
---

<ol class="hiw">
	<li class="step" style="--sa: #8b5cf6">
		<div class="marker"><span>01</span></div>
		<div class="copy">
			<h3>Append to your own log</h3>
			<p>
				Every change a device makes goes into that device's own append-only
				log, stamped with a hybrid logical clock. Writes never wait on the
				network.
			</p>
		</div>
		<figure class="vignette">
			<svg viewBox="0 0 280 150" role="img" aria-label="A device node appending stamped entries to its log">
				<circle cx="36" cy="75" r="13" fill="#8b5cf6" />
				<line x1="50" y1="75" x2="76" y2="75" stroke="#6366f1" stroke-width="5" stroke-linecap="round" opacity="0.55" />
				<g class="log">
					<rect x="82" y="30" width="160" height="18" rx="9" fill="#6366f1" opacity="0.18" />
					<rect x="82" y="66" width="132" height="18" rx="9" fill="#6366f1" opacity="0.18" />
					<rect x="82" y="102" width="146" height="18" rx="9" fill="#6366f1" opacity="0.18" />
					<circle class="stamp s1" cx="230" cy="39" r="4.5" fill="#06b6d4" />
					<circle class="stamp s2" cx="202" cy="75" r="4.5" fill="#06b6d4" />
					<circle class="stamp s3" cx="216" cy="111" r="4.5" fill="#06b6d4" />
				</g>
			</svg>
		</figure>
	</li>

	<li class="step" style="--sa: #06b6d4">
		<div class="marker"><span>02</span></div>
		<div class="copy">
			<h3>Sync the files</h3>
			<p>
				Per-device logs are plain files, copied over a shared cloud folder —
				iCloud&nbsp;Drive, Google&nbsp;Drive, Dropbox — or a sync server for
				real-time collaboration and user management. Each device writes only
				its own log and only reads everyone else's, so file-level conflicts
				can't happen: no "conflicted copy" duplicates, ever.
			</p>
		</div>
		<figure class="vignette">
			<svg viewBox="0 0 280 150" role="img" aria-label="Two devices exchanging log packets through cloud storage">
				<circle cx="32" cy="75" r="13" fill="#8b5cf6" />
				<circle cx="248" cy="75" r="13" fill="#10b981" />
				<line x1="46" y1="75" x2="106" y2="75" stroke="#6366f1" stroke-width="5" stroke-linecap="round" opacity="0.55" />
				<line x1="174" y1="75" x2="234" y2="75" stroke="#6366f1" stroke-width="5" stroke-linecap="round" opacity="0.55" />
				<g class="cloud" set:html={cloud} />
				<path class="comet to-cloud" d="M16,0 L-10,-7 Q-2,0 -10,7 Z" fill="#06b6d4" />
				<path class="comet from-cloud" d="M16,0 L-10,-7 Q-2,0 -10,7 Z" fill="#06b6d4" />
			</svg>
		</figure>
	</li>

	<li class="step" style="--sa: #10b981">
		<div class="marker"><span>03</span></div>
		<div class="copy">
			<h3>Replay and converge</h3>
			<p>
				Peers replay each other's logs in clock order: structured rows merge
				last-writer-wins, rich text merges as a CRDT. Every device converges on
				the same state — conflicts are impossible by construction.
			</p>
		</div>
		<figure class="vignette">
			<svg viewBox="0 0 280 150" role="img" aria-label="Two device logs merging conflict-free into one converged state">
				<circle cx="30" cy="38" r="10" fill="#8b5cf6" />
				<circle cx="30" cy="112" r="10" fill="#3b82f6" />
				<path d="M42 38 C 120 38, 156 75, 204 75" fill="none" stroke="#6366f1" stroke-width="5" stroke-linecap="round" opacity="0.55" />
				<path d="M42 112 C 120 112, 156 75, 204 75" fill="none" stroke="#06b6d4" stroke-width="5" stroke-linecap="round" opacity="0.55" />
				<circle cx="222" cy="75" r="14" fill="#10b981" />
				<path d="M215.5 75.5 l4.5 4.5 l8.5 -9.5" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
				<path class="comet rider top" d="M16,0 L-10,-7 Q-2,0 -10,7 Z" fill="#8b5cf6" />
				<path class="comet rider bottom" d="M16,0 L-10,-7 Q-2,0 -10,7 Z" fill="#06b6d4" />
			</svg>
		</figure>
	</li>
</ol>

<style>
	.hiw {
		list-style: none;
		padding: 0;
		margin-top: 1.5rem;
	}

	.step {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 1.1fr);
		gap: 0 1.25rem;
		align-items: center;
	}

	.step + .step {
		margin-top: 0;
	}

	/* ── marker rail ─────────────────────────────────────────────── */
	.marker {
		display: flex;
		flex-direction: column;
		align-items: center;
		align-self: stretch;
		gap: 0.5rem;
	}

	.marker span {
		display: grid;
		place-items: center;
		inline-size: 2.5rem;
		block-size: 2.5rem;
		border-radius: 50%;
		border: 1px solid color-mix(in srgb, var(--sa) 55%, transparent);
		background: color-mix(in srgb, var(--sa) 10%, transparent);
		color: var(--sa);
		font-family: var(--sl-font-system-mono, ui-monospace, monospace);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.04em;
	}

	/* wire segment connecting this step's node to the next */
	.step:not(:last-child) .marker::after {
		content: '';
		flex: 1;
		inline-size: 2px;
		border-radius: 1px;
		margin-block-start: 0.25rem;
		background: linear-gradient(
			to bottom,
			color-mix(in srgb, var(--sa) 50%, transparent),
			color-mix(in srgb, var(--sa) 8%, transparent)
		);
	}

	/* ── copy ────────────────────────────────────────────────────── */
	.copy h3 {
		margin: 0;
		font-size: var(--sl-text-lg);
		font-weight: 600;
		letter-spacing: -0.015em;
		color: var(--sl-color-white);
	}

	.copy p {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		line-height: 1.65;
		color: var(--sl-color-gray-2);
	}

	/* ── vignette panel ──────────────────────────────────────────── */
	.vignette {
		margin: 1.25rem 0;
		border-radius: 1rem;
		border: 1px solid color-mix(in srgb, var(--sa) 22%, transparent);
		background:
			radial-gradient(
				120% 100% at 50% -20%,
				color-mix(in srgb, var(--sa) 7%, transparent),
				transparent 60%
			),
			color-mix(in srgb, var(--sl-color-white) 3%, var(--sl-color-black));
	}

	:global([data-theme='light']) .vignette {
		background:
			radial-gradient(
				120% 100% at 50% -20%,
				color-mix(in srgb, var(--sa) 6%, transparent),
				transparent 60%
			),
			#fff;
	}

	.vignette svg {
		display: block;
		width: 100%;
		height: auto;
	}

	.cloud {
		color: #6366f1;
	}

	/* ── motion ──────────────────────────────────────────────────── */
	.stamp {
		animation: stamp-pulse 3.6s ease-in-out infinite;
	}
	.s2 {
		animation-delay: 1.2s;
	}
	.s3 {
		animation-delay: 2.4s;
	}

	@keyframes stamp-pulse {
		0%,
		100% {
			opacity: 0.45;
		}
		12% {
			opacity: 1;
		}
	}

	.comet {
		opacity: 0;
	}

	.to-cloud {
		animation: comet-right 3.2s ease-in-out infinite;
	}

	.from-cloud {
		transform-origin: center;
		animation: comet-left 3.2s ease-in-out infinite;
		animation-delay: 1.6s;
	}

	@keyframes comet-right {
		0% {
			transform: translate(48px, 75px);
			opacity: 0;
		}
		12% {
			opacity: 1;
		}
		42% {
			opacity: 1;
		}
		55%,
		100% {
			transform: translate(102px, 75px);
			opacity: 0;
		}
	}

	@keyframes comet-left {
		0% {
			transform: translate(232px, 75px) rotate(180deg);
			opacity: 0;
		}
		12% {
			opacity: 1;
		}
		42% {
			opacity: 1;
		}
		55%,
		100% {
			transform: translate(178px, 75px) rotate(180deg);
			opacity: 0;
		}
	}

	/* comets riding the merge curves */
	@supports (offset-path: path('M0 0 L1 1')) {
		.rider {
			offset-rotate: auto;
			animation: ride 4s ease-in-out infinite;
		}
		.rider.top {
			offset-path: path('M42 38 C 120 38, 156 75, 204 75');
		}
		.rider.bottom {
			offset-path: path('M42 112 C 120 112, 156 75, 204 75');
			animation-delay: 2s;
		}
	}

	@keyframes ride {
		0% {
			offset-distance: 0%;
			opacity: 0;
		}
		10% {
			opacity: 1;
		}
		50% {
			opacity: 1;
		}
		62%,
		100% {
			offset-distance: 100%;
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.stamp,
		.comet {
			animation: none;
		}
		.stamp {
			opacity: 1;
		}
	}

	/* ── mobile ──────────────────────────────────────────────────── */
	@media (max-width: 50rem) {
		.step {
			grid-template-columns: 3rem minmax(0, 1fr);
		}

		.copy {
			grid-column: 2;
		}

		.vignette {
			grid-column: 2;
			margin-top: 1rem;
		}
	}
</style>
