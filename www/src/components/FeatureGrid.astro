---
/** Flat, equal-height grid of Feature cards with a time-staggered entrance. */
---

<div class="feature-grid"><slot /></div>

<style>
	.feature-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-auto-rows: 1fr;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	@media (max-width: 50rem) {
		.feature-grid {
			grid-template-columns: 1fr;
		}
	}

	/* stagger in time, not in space */
	.feature-grid > :global(:nth-child(2)) {
		--rise-delay: 90ms;
	}
	.feature-grid > :global(:nth-child(3)) {
		--rise-delay: 180ms;
	}
	.feature-grid > :global(:nth-child(4)) {
		--rise-delay: 270ms;
	}
	.feature-grid > :global(:nth-child(5)) {
		--rise-delay: 360ms;
	}
	.feature-grid > :global(:nth-child(6)) {
		--rise-delay: 450ms;
	}
</style>
