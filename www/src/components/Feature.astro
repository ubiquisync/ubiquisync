---
/**
 * One feature "node": a glass card keyed to a single hue from the logo's
 * peer ring, with a free-floating Phosphor duotone glyph.
 */
interface Props {
	title: string;
	/** Phosphor icon name, e.g. "git-merge" (duotone weight is loaded). */
	icon: string;
	/** Accent color for this card — one of the logo's node hues. */
	accent: string;
}

const { title, icon, accent } = Astro.props;

const icons = import.meta.glob<string>(
	'/node_modules/@phosphor-icons/core/assets/duotone/*.svg',
	{ query: '?raw', import: 'default' }
);
const loader = icons[`/node_modules/@phosphor-icons/core/assets/duotone/${icon}-duotone.svg`];
if (!loader) throw new Error(`Unknown Phosphor icon: ${icon}`);
const svg = await loader();
---

<article class="feature" style={`--fa: ${accent}`}>
	<div class="glyph" set:html={svg} />
	<h3 class="title">{title}</h3>
	<div class="body"><slot /></div>
</article>

<style>
	.feature {
		position: relative;
		overflow: hidden;
		border-radius: 1rem;
		padding: 1.625rem 1.5rem 1.5rem;
		background:
			radial-gradient(
				130% 90% at 18% -10%,
				color-mix(in srgb, var(--fa) 10%, transparent),
				transparent 55%
			),
			color-mix(in srgb, var(--sl-color-white) 4%, var(--sl-color-black));
		animation: feature-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: var(--rise-delay, 0s);
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease;
	}

	/* hairline gradient border, brightest where the accent glow sits */
	.feature::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		padding: 1px;
		background: linear-gradient(
			155deg,
			color-mix(in srgb, var(--fa) 55%, transparent),
			color-mix(in srgb, var(--fa) 14%, transparent) 38%,
			color-mix(in srgb, var(--sl-color-white) 10%, transparent)
		);
		-webkit-mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		mask:
			linear-gradient(#000 0 0) content-box,
			linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		pointer-events: none;
	}

	/* the comet: a streak of light along the top wire */
	.feature::after {
		content: '';
		position: absolute;
		top: 0;
		left: 10%;
		width: 30%;
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent,
			color-mix(in srgb, var(--fa) 90%, #fff),
			transparent
		);
		opacity: 0.45;
		transition:
			opacity 0.3s ease,
			translate 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.feature:hover {
		transform: translateY(-3px);
		box-shadow: 0 16px 40px -20px color-mix(in srgb, var(--fa) 55%, transparent);
	}

	.feature:hover::after {
		opacity: 1;
		translate: 160% 0;
	}

	.glyph {
		inline-size: 2.125rem;
		color: var(--fa);
		filter: drop-shadow(0 0 14px color-mix(in srgb, var(--fa) 50%, transparent));
	}

	.glyph :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}

	.title {
		margin-top: 1rem;
		font-size: var(--sl-text-lg);
		font-weight: 600;
		letter-spacing: -0.015em;
		line-height: 1.3;
		color: var(--sl-color-white);
	}

	.body {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		line-height: 1.65;
		color: var(--sl-color-gray-2);
	}

	.body :global(p) {
		margin: 0;
	}

	/* Light mode: lift the glass off a white page instead of a dark one */
	:global([data-theme='light']) .feature {
		background:
			radial-gradient(
				130% 90% at 18% -10%,
				color-mix(in srgb, var(--fa) 8%, transparent),
				transparent 55%
			),
			#fff;
		box-shadow: 0 1px 2px color-mix(in srgb, var(--sl-color-gray-1) 8%, transparent);
	}

	:global([data-theme='light']) .feature::before {
		background: linear-gradient(
			155deg,
			color-mix(in srgb, var(--fa) 45%, transparent),
			color-mix(in srgb, var(--fa) 16%, transparent) 38%,
			color-mix(in srgb, var(--sl-color-gray-1) 14%, transparent)
		);
	}

	:global([data-theme='light']) .body {
		color: var(--sl-color-gray-3);
	}

	@keyframes feature-rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.feature {
			animation: none;
		}
		.feature,
		.feature::after {
			transition: none;
		}
	}
</style>
